{
  "name": "cypress-demo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "open": "cypress open",
    "run:headless": "cypress run --browser chrome",
    "clean-reports": "rm -rf cypress/reports/*",
    "report": "cypress run --browser chrome --reporter mochawesome --reporter-options reportDir=cypress/reports,overwrite=false,html=false,json=true",
    "merge-report": "npx mochawesome-merge cypress/reports/*.json > cypress/reports/merged.json",
    "html-report": "npx marge cypress/reports/merged.json --reportDir cypress/reports --inline",
    "postreport": "npm run merge-report && npm run html-report && open cypress/reports/merged.html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiman-zahid-qbatch/cypress-demo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/aiman-zahid-qbatch/cypress-demo/issues"
  },
  "homepage": "https://github.com/aiman-zahid-qbatch/cypress-demo#readme",
  "devDependencies": {
    "cypress": "^15.1.0",
    "cypress-mochawesome-reporter": "^4.0.2",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}
